   journal = {Indian Journal of Radiology and Imaging},
   keywords = {ALARA,interventional radiology,radiation protection},
   month = {10},
   pages = {939-945},
   publisher = {Georg Thieme Verlag},
   title = {Radiation Protection in Interventional Radiology},
   volume = {31},
   year = {2021}
}
