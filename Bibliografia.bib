   volume = {9286},
   year = {2014}

}
@techReport{99,
   abstract = {■ We discuss the properties of Geiger-mode avalanche photodiodes (APDs) and their use in developing an imaging laser radar (ladar). This type of photodetector gives a fast electrical pulse in response to the detection of even a single photon, allowing for sub-nsec-precision photon-flight-time measurement. We present ongoing work at Lincoln Laboratory on three-dimensional (3D) imaging with arrays of these diodes, and the integration of the arrays with fast complementary metal-oxide semiconductor (CMOS) digital timing circuits.},
   author = {Brian F Aull and Andrew H Loomis and Douglas J Young and Richard M Heinrichs and Bradley J Felton and Peter J Daniels and Deborah J Landers},
   issue = {2},
   journal = {LINCOLN LABORATORY JOURNAL},
   title = {Mode Avalanche Photodiodes for Three-Dimensional Imaging},
   volume = {13},
   year = {2002}
}
